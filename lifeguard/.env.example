# Copy to .env and fill in. Every integration is optional: anything left blank
# falls back to an offline mock so the app always runs and the demo never dies.

PORT=3000
PUBLIC_URL=http://localhost:3000        # set to https://yourname.tech once deployed

# Photon / Spectrum (app.photon.codes -> project Settings)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
USE_TERMINAL=true                       # also chat with the agent from your terminal

# Capital One Nessie (api.nessieisreal.com, get key at sign in)
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=                      # filled in by `npm run seed`
POLL_SECONDS=10

# Google Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Snowflake Cortex REST API (second opinion model)
SNOWFLAKE_ACCOUNT_URL=                  # e.g. https://abc12345.us-east-1.snowflakecomputing.com
SNOWFLAKE_PAT=                          # programmatic access token
SNOWFLAKE_MODEL=llama3.1-70b

# ElevenLabs (elevenlabs.io -> Profile -> API key)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Tiger Data (console.cloud.timescale.com -> service connection string)
TIGER_DATABASE_URL=

# Solana devnet (run `npm run solana:wallet` to generate + airdrop)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY=                      # JSON array, written by solana:wallet
